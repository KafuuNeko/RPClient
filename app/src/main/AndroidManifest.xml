<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 允许选择菜单发现翻译、朗读等第三方文本处理入口。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:name=".RPClientApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RPClient"
        android:usesCleartextTraffic="true">
        <!-- 仅供应用内选择菜单调用，避免在其他应用中增加同名分享入口。 -->
        <activity
            android:name=".feature.textshare.TextShareActivity"
            android:exported="false"
            android:label="@string/text_selection_share"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity
            android:name=".feature.about.AboutActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.jsonviewer.JsonViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.requestlog.RequestLogActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.tokenusage.TokenUsageActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.regexscript.RegexScriptActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.characteredit.CharacterEditActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.imagecrop.ImageCropActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.llmprovideredit.LLMProviderEditActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.llmproviderlist.LLMProviderListActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.worldbookedit.WorldBookEditActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.worldbookentryedit.WorldBookEntryEditActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.worldbooklist.WorldBookListActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.chat.ChatActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.chatcreate.ChatCreateActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.groupchat.GroupChatActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.groupchatcreate.GroupChatCreateActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.storycreate.StoryCreateActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.storyeditor.StoryEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.characterlist.CharacterListActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.promptpreset.PromptPresetActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.main.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
